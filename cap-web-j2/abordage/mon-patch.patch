diff --git a/tests/normaliser.test.js b/tests/normaliser.test.js
new file mode 100644
index 0000000..7b581e8
--- /dev/null
+++ b/tests/normaliser.test.js
@@ -0,0 +1,13 @@
+import { it } from 'node:test';
+import assert from 'node:assert/strict';
+import { normaliser, replyTo } from '../public/js/brain.js';
+
+it('normaliser retire les espaces autour et met le message en minuscules', () => {
+  assert.equal(normaliser('BonJour'), 'bonjour');
+  assert.equal(normaliser('  SALUT '), 'salut');
+});
+
+it('répond à « au revoir » par une réponse propre, quelles que soient la casse et les espaces autour', () => {
+  assert.notEqual(replyTo('au revoir'), replyTo('parle-moi de la météo'));
+  assert.equal(replyTo('  AU REVOIR '), replyTo('au revoir'));
+});
